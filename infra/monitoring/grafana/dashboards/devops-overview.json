    {
      "title": "Jenkins Agent Executors (In-Use vs Free)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ds-prom-compose"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "id": 12,
      "targets": [
        {
          "expr": "jenkins_executor_in_use_value or vector(0)",
