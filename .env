# --- Project Settings ---
COMPOSE_PROJECT_NAME=devops-test

# --- Jenkins Controller & Auto-Agent ---
JENKINS_IMAGE=jenkins/jenkins:lts-jdk21
JENKINS_AGENT_IMAGE=jenkins/inbound-agent:latest-jdk21
JENKINS_PORT=8080
JENKINS_JNLP_PORT=50000
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASS=admin123
JENKINS_AGENT_NAME=k8s-auto-agent
JENKINS_AGENT_EXECUTORS=4
JENKINS_AGENT_LABELS=k8s docker helm linux

# --- K3s Lightweight Kubernetes ---
K3S_IMAGE=rancher/k3s:v1.36.5-k3s1
K3S_TOKEN=supersecret-k3s-cluster-token
K3S_API_PORT=6443
K3S_HTTP_NODEPORT=30080
K3S_PROM_NODEPORT=30090
K3S_GRAFANA_NODEPORT=30300

# --- Docker-in-Docker & Local Registry ---
DIND_IMAGE=docker:27-dind
REGISTRY_IMAGE=registry:2
REGISTRY_PORT=5000

# --- Central Monitoring Stack ---
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=admin123
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.25.0
BLACKBOX_PORT=9115

# --- Demo Application Ports (when uncommented in Compose for local testing) ---
DEMO_FE_PORT=8000
DEMO_BE_PORT=4000
